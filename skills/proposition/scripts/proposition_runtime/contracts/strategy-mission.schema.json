{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "need_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "string",
      "minLength": 1
    },
    "stop": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "need_ids",
    "outcome",
    "limits",
    "source_ids",
    "target",
    "task",
    "success",
    "stop"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
