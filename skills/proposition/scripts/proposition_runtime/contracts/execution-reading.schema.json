{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt-[0-9a-f]{32}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "host_job_ref": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "mechanical_read",
        "agent_declared_reading"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "read_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:])[A-Za-z0-9_. /-]+$",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ]
      },
      "minItems": 1,
      "maxItems": 6000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "request_hash",
    "manifest_hash",
    "worker_id",
    "host_job_ref",
    "kind",
    "observed_at",
    "read_files",
    "limitations"
  ]
}
