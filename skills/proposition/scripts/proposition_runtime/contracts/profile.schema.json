{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic local configuration; no private defaults",
  "type": "object",
  "required": [
    "actor",
    "responsible",
    "responsible_confirmed",
    "required_reviewers",
    "parameters"
  ],
  "properties": {
    "actor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "responsible": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "responsible_confirmed": {
      "type": "boolean"
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "preprocess_mode": {
          "enum": ["auto", "codex", "cloudflare"]
        },
        "delivery_scope": {
          "enum": [
            "full",
            "client"
          ]
        },
        "proposal_contract": {
          "const": 2
        },
        "history_mode": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "history_deadline_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "history_request_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "history_max_requests": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "history_max_urls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "history_max_captures": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 4
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
