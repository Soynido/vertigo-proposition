{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic local configuration; no private defaults",
  "type": "object",
  "required": [
    "actor",
    "responsible",
    "responsible_confirmed",
    "required_reviewers",
    "parameters"
  ],
  "properties": {
    "actor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "responsible": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "responsible_confirmed": {
      "type": "boolean"
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
