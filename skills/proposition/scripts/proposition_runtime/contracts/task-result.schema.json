{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task-[0-9a-f]{24}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt-[0-9a-f]{32}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxProperties": 20000
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxProperties": 20000
    },
    "consumed_packet_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "read_receipt_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:])[A-Za-z0-9_. /-]+$",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "PARTIAL"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:])[A-Za-z0-9_. /-]+$",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "enum": [
              "public",
              "client",
              "sales",
              "technical",
              "internal"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "role",
          "audience"
        ]
      },
      "maxItems": 6000
    },
    "operations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "source.register"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "public",
                      "private",
                      "observation",
                      "client",
                      "generated"
                    ]
                  },
                  "locator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "enum": [
                      "COLLECTED",
                      "INACCESSIBLE",
                      "UNKNOWN",
                      "STALE"
                    ]
                  },
                  "audience": {
                    "enum": [
                      "client",
                      "sales",
                      "technical",
                      "internal",
                      "public"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  }
                },
                "required": [
                  "source_id"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "source.reobserve"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "public",
                      "private",
                      "observation",
                      "client",
                      "generated"
                    ]
                  },
                  "locator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "enum": [
                      "COLLECTED",
                      "INACCESSIBLE",
                      "UNKNOWN",
                      "STALE"
                    ]
                  },
                  "audience": {
                    "enum": [
                      "client",
                      "sales",
                      "technical",
                      "internal",
                      "public"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "observed_at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observation_proof": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "size_bytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "role": {
                            "type": "string",
                            "minLength": 1
                          },
                          "audience": {
                            "enum": [
                              "client",
                              "sales",
                              "technical",
                              "internal",
                              "public"
                            ]
                          }
                        },
                        "required": [
                          "path",
                          "sha256",
                          "size_bytes",
                          "role",
                          "audience"
                        ]
                      },
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "file",
                      "source_id"
                    ]
                  }
                },
                "required": [
                  "source_id",
                  "observed_at",
                  "observation_proof"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "fact.register"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fact_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "value": {},
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 1000
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audience": {
                    "enum": [
                      "client",
                      "sales",
                      "technical",
                      "internal",
                      "public"
                    ]
                  },
                  "public_allowed": {
                    "type": "boolean"
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "fact_id",
                  "value",
                  "source_ids"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "artifact.register"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audience": {
                    "enum": [
                      "client",
                      "sales",
                      "technical",
                      "internal",
                      "public"
                    ]
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(source|fact|artifact|evaluation|review|stage_review|checkpoint):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                    },
                    "maxItems": 20000
                  }
                },
                "required": [
                  "artifact_id",
                  "path",
                  "audience"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "evaluation.record"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requirement_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evaluation": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "status": {
                            "enum": [
                              "PASS",
                              "FAIL",
                              "UNKNOWN",
                              "NOT_APPLICABLE",
                              "STALE"
                            ]
                          },
                          "applicable": {
                            "type": "boolean"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "evidence": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^(source|fact|artifact|checkpoint):.+$"
                            }
                          },
                          "unknowns": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "dependencies": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^(source|fact|artifact|evaluation|review|stage_review|checkpoint):.+$"
                            }
                          },
                          "metadata": {
                            "type": "object"
                          }
                        },
                        "required": []
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "reviewer_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "status": {
                            "enum": [
                              "PASS",
                              "FAIL",
                              "UNKNOWN",
                              "STALE"
                            ]
                          },
                          "scores": {
                            "type": "array",
                            "minItems": 5,
                            "maxItems": 5,
                            "items": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            }
                          },
                          "independence": {
                            "type": "object",
                            "properties": {
                              "receipt_id": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "additionalProperties": false
                          },
                          "evidence": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^(source|fact|artifact|checkpoint):.+$"
                            }
                          },
                          "unknowns": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "dependencies": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^(source|fact|artifact|evaluation|review|stage_review|checkpoint):.+$"
                            }
                          },
                          "metadata": {
                            "type": "object"
                          },
                          "criterion_evidence": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "pattern": "^artifact:.+$"
                              }
                            }
                          }
                        },
                        "required": []
                      }
                    ]
                  }
                },
                "required": [
                  "requirement_id",
                  "evaluation"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "checkpoint.record"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "checkpoint_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "stage_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checkpoint": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "enum": [
                          "WAITING",
                          "COMPLETE",
                          "APPROVED",
                          "BLOCKED",
                          "UNKNOWN",
                          "STALE"
                        ]
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "approval": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "required": [
                              "actor",
                              "plan_ref",
                              "plan_sha256"
                            ],
                            "properties": {
                              "actor": {
                                "type": "string",
                                "minLength": 1
                              },
                              "plan_ref": {
                                "type": "string",
                                "pattern": "^artifact:.+$"
                              },
                              "plan_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "approved_at": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      },
                      "dependencies": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^(source|fact|artifact|evaluation|review|stage_review|checkpoint):.+$"
                        }
                      },
                      "metadata": {
                        "type": "object"
                      }
                    },
                    "required": []
                  }
                },
                "required": [
                  "checkpoint_id",
                  "stage_id",
                  "checkpoint"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "stage-review.record"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stage_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "reviewer_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "PASS",
                          "FAIL",
                          "UNKNOWN",
                          "STALE"
                        ]
                      },
                      "scores": {
                        "type": "array",
                        "minItems": 5,
                        "maxItems": 5,
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2
                        }
                      },
                      "independence": {
                        "type": "object",
                        "properties": {
                          "receipt_id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      "evidence": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^(source|fact|artifact|checkpoint):.+$"
                        }
                      },
                      "unknowns": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "dependencies": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^(source|fact|artifact|evaluation|review|stage_review|checkpoint):.+$"
                        }
                      },
                      "metadata": {
                        "type": "object"
                      },
                      "criterion_evidence": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^artifact:.+$"
                          }
                        }
                      }
                    },
                    "required": []
                  }
                },
                "required": [
                  "stage_id",
                  "review"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "strategy.register"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "report_path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "report_path"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "discovery.register"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "report_path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "report_path"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "discovery.reconcile"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "receipts_path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "receipts_path"
                ]
              }
            },
            "required": [
              "op",
              "args"
            ]
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "attempt_id",
    "request_hash",
    "input_hashes",
    "profile_hash",
    "contract_hashes",
    "consumed_packet_hash",
    "read_receipt_ref",
    "status",
    "outputs",
    "operations",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "minItems": 1
          },
          "outputs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
